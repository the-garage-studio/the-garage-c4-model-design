@startuml Catalog_ComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title The Garage - Catalog (Component Diagram)

Person(collector, "Collector", "Registered user who collects vehicle cards, opens packs, manages collections and trades cards.")

Container_Boundary(api, "REST API") {

    Component(catalog_controller, "Catalog Controller", "Java, Spring Boot REST Controller", "Handles requests to browse the vehicle card catalog and available packs.")

    Component(catalog_service, "Catalog Service", "Java, Spring Service", "Applies business rules for card and pack availability, pricing, and rarity distribution. Consumed directly by Administration for management operations.")

    Component(card_repository, "Card Repository", "Spring Data JPA Repository", "Reads and writes vehicle card definitions.")
    Component(pack_repository, "Pack Repository", "Spring Data JPA Repository", "Reads and writes pack definitions and their card pools.")

}

ContainerDb(database, "Database", "MySQL", "Stores users, cards, packs, collections, trades, subscriptions and transaction data.")

Rel(collector, catalog_controller, "Browses cards and packs", "JSON/HTTPS")

Rel(catalog_controller, catalog_service, "Delegates catalog logic")

Rel(catalog_service, card_repository, "Reads card definitions")
Rel(catalog_service, pack_repository, "Reads pack definitions")


Rel(card_repository, database, "Reads and writes card data", "SQL")
Rel(pack_repository, database, "Reads and writes pack data", "SQL")


SHOW_LEGEND()
@enduml