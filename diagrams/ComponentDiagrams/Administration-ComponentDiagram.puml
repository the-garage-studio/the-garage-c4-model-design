@startuml Administration-ComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title The Garage - Administration (Component Diagram)

Person(admin, "Administrator", "Manages the platform, users, catalog, subscriptions and marketplace operations.")

Container_Boundary(api, "REST API") {

    Component(admin_controller, "Admin Controller", "Java, Spring Boot REST Controller", "Handles administrative requests for user management, catalog management, platform monitoring, and support operations.")

    Component(admin_service, "Admin Service", "Java, Spring Service", "Coordinates administrative operations by delegating to the domain services of other bounded contexts.")

    Component(identity_acl,"Identity Access ACL","Java Interface","Provides user management operations.")
    Component(catalog_acl, "Catalog ACL","Java Interface","Provides catalog management operations.")

    Component(subscription_acl,"Subscription ACL","Java Interface","Provides subscription management operations.")

    Component(marketplace_acl,"Marketplace ACL","Java Interface","Provides marketplace moderation operations.")

    Component(wallet_acl,"Wallet ACL","Java Interface","Provides wallet management operations.")

    Component(notification_acl,"Notification ACL","Java Interface","Provides notification history queries.")
}

Rel(admin, admin_controller,"Manages users, catalog, subscriptions, marketplace and support","JSON/HTTPS")

Rel(admin_controller, admin_service,"Delegates administrative logic")

Rel(admin_service, identity_acl,"Suspends users / Reactivates users / Changes roles")

Rel(admin_service, catalog_acl,"Creates / Updates / Deletes cards and packs")

Rel(admin_service, subscription_acl,"Reviews / Overrides subscriptions")

Rel(admin_service, marketplace_acl,"Removes / Flags marketplace listings")

Rel(admin_service, wallet_acl,"Adjusts wallet balance")

Rel(admin_service, notification_acl,"Retrieves notification history")

SHOW_LEGEND()
@enduml