@startuml Notifications-ComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title The Garage - Notifications (Component Diagram)

Person(collector, "Collector", "Registered user who collects vehicle cards, opens packs, manages collections and trades cards.")

System_Ext(email, "Email Service", "Sends verification emails, password recovery messages and platform notifications.")

Container_Boundary(api, "REST API") {

    Component(notification_controller, "Notification Controller", "Java, Spring Boot REST Controller", "Handles requests to view notification history.")

    Component(notification_service, "Notification Service", "Java, Spring Service", "Central entry point for sending notifications. Consumed directly by Identity & Access, Wallet, Subscription and Marketplace to notify collectors of relevant events.")
    Component(email_sender_adapter, "Email Sender Adapter", "Java, Spring Component", "Formats and dispatches notification content to the external Email Service.")

    Component(notification_repository, "Notification Repository", "Spring Data JPA Repository", "Reads and writes sent notifications, delivery status, and recipient.")
}

ContainerDb(database, "Database", "MySQL", "Stores users, cards, packs, collections, trades, subscriptions and transaction data.")

Rel(collector, notification_controller, "Views notification history", "JSON/HTTPS")

Rel(notification_controller, notification_service, "Delegates history queries")

Rel(notification_service, email_sender_adapter, "Dispatches formatted notification")
Rel(notification_service, notification_repository, "Records sent notification and status")

Rel(email_sender_adapter, email, "Sends emails", "SMTP/API")

Rel(notification_repository, database, "Reads and writes notification data", "SQL")

SHOW_LEGEND()
@enduml